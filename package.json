{
  "name": "scholarcrew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "turbo run dev",
    "db:up": "docker compose up -d db",
    "db:wait": "pnpm --filter @scholarcrew/scripts wait-for-db",
    "db:generate": "pnpm --filter @scholarcrew/db generate",
    "db:migrate": "pnpm --filter @scholarcrew/db migrate",
    "db:migrate:test": "pnpm --filter @scholarcrew/db migrate:test",
    "db:seed": "pnpm --filter @scholarcrew/db seed",
    "e2e": "pnpm --filter @scholarcrew/e2e e2e",
    "evals": "pnpm --filter @scholarcrew/evals evals",
    "audit:production": "pnpm --filter @scholarcrew/web build && pnpm --filter @scholarcrew/extension build && E2E_PRODUCTION=1 pnpm --filter @scholarcrew/e2e exec playwright test tests/production-audit.spec.ts tests/extension-compatibility.spec.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.15.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
